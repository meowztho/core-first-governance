{
  "skill_name": "core-first-orchestration",
  "schema_version": 1,
  "evals": [
    {
      "id": "trivial-local-edit",
      "prompt": "Change one static button label and run the relevant test.",
      "expected": {
        "main_uses_core_first": false,
        "observable_product_verification": false,
        "delegation": "NONE_OR_TARGETED_ONLY",
        "core_first_verifier": false,
        "independent_review": false
      }
    },
    {
      "id": "bounded-leaf-worker",
      "prompt": "Architecture already defines StorageOwner -> StorageContract -> S3Provider. Delegate implementation of one missing S3 error mapper.",
      "expected": {
        "main_uses_core_first": true,
        "worker_mode": "TARGETED_WORKER",
        "worker_core_first_skill": false,
        "worker_may_decide_architecture": false
      }
    },
    {
      "id": "worker-hits-architecture-question",
      "prompt": "A targeted worker discovers the requested field would require a new authoritative state owner.",
      "expected": {
        "worker_action": "ARCHITECTURE_DECISION_REQUIRED",
        "main_reassesses_with_core_first": true
      }
    },
    {
      "id": "new-extension-point",
      "prompt": "Add a public executable extension point used by third parties.",
      "expected": {
        "main_uses_core_first": true,
        "fresh_core_first_verifier": true,
        "independent_review": true,
        "architecture_delegated_agent_skill": "core-first-extension-architecture"
      }
    },
    {
      "id": "post-compaction-architecture-change",
      "prompt": "Context was compacted. Continue a change that modifies ownership boundaries.",
      "expected": {
        "reload_core_first_skill": true,
        "reload_relevant_authorities": true,
        "continue_from_memory_only": false
      }
    },
    {
      "id": "independent-review-isolation",
      "prompt": "A high-risk architecture change passed Core-First verification and now needs independent review.",
      "expected": {
        "fresh_independent_reviewer": true,
        "preload_core_first_skill": false,
        "pass_implementation_narrative": false,
        "pass_original_requirements": true,
        "pass_raw_diff_and_test_output": true,
        "pass_raw_observable_runtime_evidence_when_available": true,
        "pass_observable_verification_conclusion_before_independent_derivation": false
      }
    },
    {
      "id": "persistent-advisor-not-verifier",
      "prompt": "A persistent Core-First advisor helped design the feature for several turns. Perform final architecture verification.",
      "expected": {
        "reuse_advisor_as_final_verifier": false,
        "fresh_core_first_verifier": true
      }
    },
    {
      "id": "interactive-slider-fix",
      "prompt": "Fix a settings slider that exists in code but users report it does not move or apply its value.",
      "expected": {
        "observable_product_verification": true,
        "tool_action_alone_sufficient": false,
        "verify_settled_outcome": true,
        "ambient_observation": true,
        "cheap_adjacent_check": true
      }
    },
    {
      "id": "game-runtime-bug",
      "prompt": "The jump implementation looks correct and unit tests pass, but the character sometimes falls through the floor after landing.",
      "expected": {
        "observable_product_verification": true,
        "verify_real_runtime_path": true,
        "preserve_failing_observable_for_core_first_trace": true
      }
    },
    {
      "id": "backend-refactor-no-surface-claim",
      "prompt": "Refactor an internal pure helper without changing behavior or external contracts; focused unit tests cover it.",
      "expected": {
        "observable_product_verification": false,
        "do_not_force_product_surface": true
      }
    },
    {
      "id": "missing-runtime-capability",
      "prompt": "Acceptance requires a native interactive workflow, but the current host cannot run or interact with that application.",
      "expected": {
        "observable_product_verification": true,
        "observable_status": "INCONCLUSIVE",
        "do_not_downgrade_to_static_pass": true
      }
    },
    {
      "id": "observable-verification-to-independent-review",
      "prompt": "A consequential user workflow has raw screenshots and before/after runtime evidence from observable-product verification, which concluded VERIFIED. Route it to independent review without anchoring.",
      "expected": {
        "fresh_independent_reviewer": true,
        "pass_raw_observable_runtime_evidence": true,
        "pass_observable_verification_status_before_independent_derivation": false,
        "pass_observable_verification_finding_narrative_before_independent_derivation": false,
        "independent_reviewer_derives_outcome_itself": true
      }
    },
    {
      "id": "files-listed-but-not-consumed",
      "prompt": "A porting task contains architecture notes, format documentation, source files, and migration notes. The agent lists all files, skims one, then starts implementing from assumptions.",
      "expected": {
        "grounded_execution_preflight": true,
        "listing_counts_as_consumed": false,
        "inspect_material_sources": true,
        "map_extracted_facts_into_plan": true,
        "implementation_before_consumption": false
      }
    },
    {
      "id": "hidden-toolchain-prerequisite",
      "prompt": "A legacy project file is present and a decompiler/parser is installed, but that tool supports only an exported format, not the exact binary input. Port the project.",
      "expected": {
        "grounded_execution_preflight": true,
        "verify_exact_input_tool_compatibility": true,
        "surface_conversion_or_external_tool_prerequisite_before_implementation": true,
        "build_speculative_replacement_first": false
      }
    },
    {
      "id": "research-result-ignored",
      "prompt": "Research finds that only Library C supports a required feature, but the agent plans to use Library A from memory.",
      "expected": {
        "research_must_be_consumed_by_plan": true,
        "plan_using_contradicted_assumption": false
      }
    },
    {
      "id": "external-blocker-surfaced-early",
      "prompt": "The only valid conversion requires a licensed desktop program the current environment cannot access.",
      "expected": {
        "surface_real_blocker_before_substitute_implementation": true,
        "ask_user_only_for_external_access_or_decision": true,
        "invent_fake_toolchain": false
      }
    },
    {
      "id": "existing-external-completion-authority",
      "prompt": "The repository defines an external acceptance validator as the completion authority. Governance checks and review all pass.",
      "expected": {
        "run_project_defined_completion_authority": true,
        "governance_self_certifies_instead": false,
        "governance_evidence_supplements_authority": true
      }
    },
    {
      "id": "no-external-completion-authority",
      "prompt": "A normal repository has no external completion owner or acceptance validator beyond its existing tests and task acceptance.",
      "expected": {
        "invent_completion_platform": false,
        "hardwire_specific_apc_or_validator": false
      }
    },
    {
      "id": "primary-direct-implementation-still-core-first",
      "prompt": "Implement a reusable cross-module capability directly in the primary agent; do not delegate it.",
      "expected": {
        "main_loads_core_first": true,
        "main_applies_core_first_itself": true,
        "delegation_required": false,
        "direct_execution_bypasses_core_first": false
      }
    },
    {
      "id": "primary-core-first-before-delegation",
      "prompt": "A material reusable feature will be delegated after the primary agent frames the work.",
      "expected": {
        "main_loads_core_first": true,
        "main_decides_owner_and_change_boundary_before_delegation": true,
        "delegated_core_first_discharges_main_duty": false
      }
    },
    {
      "id": "no-subagents-preserves-core-first",
      "prompt": "The host has no delegated-agent capability. Implement an architecture-relevant change.",
      "expected": {
        "main_performs_lane": true,
        "main_loads_and_applies_core_first": true,
        "skip_core_first_due_to_missing_subagent": false
      }
    },
    {
      "id": "architecture-discovered-mid-task-triggers-core-first",
      "prompt": "A task starts as a local edit, but inspection reveals it would introduce shared authoritative behavior across consumers.",
      "expected": {
        "continue_as_trivial": false,
        "load_core_first_before_material_architecture_edit": true,
        "main_reclassifies_boundary": true
      }
    },
    {
      "id": "skill-routing-without-preloading-all",
      "prompt": "A non-trivial task may need one or more sibling procedures. Route the work without stuffing every Skill body into the primary context up front.",
      "expected": {
        "routing_knowledge_available": true,
        "preload_all_sibling_skills": false,
        "load_only_material_procedures": true,
        "canonical_skill_body_remains_authority": true
      }
    },
    {
      "id": "native-skill-discovery-is-optimization-not-authority",
      "prompt": "The host exposes names/descriptions for all plugin Skills and can load them on demand.",
      "expected": {
        "use_native_discovery_when_suitable": true,
        "duplicate_full_skill_bodies_in_orchestrator": false,
        "portable_routing_requirement_removed": false,
        "host_metadata_becomes_policy_owner": false
      }
    },
    {
      "id": "thin-host-routing-fallback",
      "prompt": "The host has no Skill metadata/discovery UI but can read installed Skill files by path.",
      "expected": {
        "use_orchestration_routing_capsule": true,
        "load_required_skill_jit": true,
        "preload_all_skills": false
      }
    },
    {
      "id": "nontrivial-adaptive-execution-before-edits",
      "prompt": "Implement a multi-file feature with ordered dependencies and checkpoints.",
      "expected": {
        "inspect_current_context_before_material_write": true,
        "adaptive_execution_state": true,
        "meaningful_ordered_steps": true,
        "material_edit_before_execution_frame": false
      }
    },
    {
      "id": "trivial-edit-no-planning-ceremony",
      "prompt": "Change one already-understood static string in one file and run its focused test.",
      "expected": {
        "forced_plan": false,
        "forced_delegation": false,
        "forced_extra_review": false
      }
    },
    {
      "id": "native-planner-reused-not-duplicated",
      "prompt": "The host provides a suitable native plan/task tracker for a non-trivial implementation task.",
      "expected": {
        "native_capability_may_satisfy_invariant": true,
        "second_governance_plan_artifact_required": false,
        "portable_requirement_removed": false
      }
    },
    {
      "id": "no-native-planner-lightweight-fallback",
      "prompt": "A thin host has no Plan Mode or task tracker; the task is materially multi-step.",
      "expected": {
        "planning_requirement_dropped": false,
        "lightweight_fallback_execution_state": true,
        "provider_specific_tool_required": false
      }
    },
    {
      "id": "invalidating-evidence-replans-before-continuing",
      "prompt": "Mid-implementation evidence proves the selected library/tool/owner assumption wrong and changes the best path.",
      "expected": {
        "continue_stale_plan": false,
        "new_evidence_consumed": true,
        "replan_before_further_material_execution": true
      }
    },
    {
      "id": "post-compaction-reconcile-plan-and-authorities",
      "prompt": "A long task resumes after major compaction with a prior plan and partial progress.",
      "expected": {
        "trust_old_plan_as_authority": false,
        "inspect_current_repo_external_state": true,
        "reload_only_required_skills_and_authorities": true,
        "reconcile_progress_and_assumptions": true,
        "replan_if_next_best_action_changed": true
      }
    },
    {
      "id": "implementation-intent-continues-end-to-end",
      "prompt": "The user asks to implement/fix a non-trivial issue; no material user-owned blocker remains after preflight.",
      "expected": {
        "stop_after_analysis_or_plan": false,
        "implement_within_authorized_scope": true,
        "run_applicable_verification": true
      }
    },
    {
      "id": "plan-review-only-does-not-mutate",
      "prompt": "The user explicitly asks only for a plan/review/diagnosis of a non-trivial change.",
      "expected": {
        "inspect_allowed": true,
        "adaptive_plan_allowed": true,
        "material_write": false,
        "silent_transition_to_implementation": false
      }
    },
    {
      "id": "jit-orchestration-procedure-routing",
      "prompt": "A non-trivial implementation needs adaptive execution but has no opaque sources, no delegation, and no special review/completion trigger.",
      "expected": {
        "load_all_orchestration_references": false,
        "load_adaptive_execution_reference": true,
        "load_grounded_preflight_reference_without_trigger": false,
        "load_delegation_reference_without_trigger": false,
        "load_verification_reference_before_trigger": false
      }
    },
    {
      "id": "primary-kernel-retains-core-first-duty-after-context-optimization",
      "prompt": "The orchestration Skill has been compressed with JIT references. The primary agent directly implements a reusable cross-system feature without subagents.",
      "expected": {
        "primary_agent_is_not_dispatcher_only": true,
        "load_core_first_extension_architecture": true,
        "primary_agent_applies_core_first_itself": true,
        "direct_implementation_does_not_bypass_core_first": true
      }
    },
    {
      "id": "visual-claim-routes-to-opv-not-logs",
      "prompt": "Automated logs say the new start screen loaded successfully, but the acceptance claim is that the start screen looks correct to the user.",
      "expected": {
        "logs_sufficient_for_user_visible_claim": false,
        "load_observable_product_verification": true,
        "real_visible_surface_required": true
      }
    },
    {
      "id": "surface-authority-consumed-before-visual-implementation",
      "prompt": "A non-trivial start-screen redesign has an approved mockup, product vision, and existing UI layout reference. The agent is about to implement after only listing those files.",
      "expected": {
        "listing_sources_is_consumption": false,
        "load_grounded_execution_preflight": true,
        "consume_task_relevant_surface_authority": true,
        "derive_task_relevant_surface_working_model": true,
        "new_mandatory_authority_file": false
      }
    },
    {
      "id": "working-atlas-is-derived-cache-not-authority",
      "prompt": "For a complex UI flow the agent creates an HTML storyboard/Working Atlas that links project sources and sketches its interpretation. Later the storyboard conflicts with the canonical UI specification.",
      "expected": {
        "working_atlas_allowed": true,
        "working_atlas_is_project_truth": false,
        "canonical_authority_wins": true,
        "reconcile_or_update_working_view": true
      }
    },
    {
      "id": "working-atlas-only-when-useful",
      "prompt": "A one-line isolated configuration edit has no spatial, multi-system, restart, or context-recovery complexity.",
      "expected": {
        "mandatory_working_atlas": false,
        "mandatory_html_artifact": false,
        "take_short_path": true
      }
    },
    {
      "id": "relative-surface-guidance-does-not-invent-coordinates",
      "prompt": "The approved reference says the primary action is centered below the title with generous spacing but gives no pixel coordinates.",
      "expected": {
        "preserve_relative_intent": true,
        "invent_exact_coordinates_as_authority": false,
        "confirmed_inferred_unknown_distinction": true
      }
    },
    {
      "id": "subtree-falsification-removes-dependent-hypotheses",
      "prompt": "A runtime artifact is suspected to come from subtree A. The agent hides/disables the entire subtree and the artifact remains unchanged.",
      "expected": {
        "subtree_a_eliminated": true,
        "dependent_hypotheses_removed": true,
        "continue_variants_of_subtree_a_hypothesis": false,
        "rederive_search_space_before_more_material_work": true
      }
    },
    {
      "id": "disproven-hypothesis-family-not-retried",
      "prompt": "A focused test disproves the premise that the visible defect originates from the match/HUD owner. Several visually similar HUD-related candidates remain imaginable.",
      "expected": {
        "visual_similarity_overrides_falsification": false,
        "generate_more_same_family_variants": false,
        "active_model_updated_from_evidence": true
      }
    },
    {
      "id": "visible-footprint-does-not-identify-source-bounds",
      "prompt": "A large visual artifact is visible, but no node/control has declared bounds matching that artifact size. A smaller child begins exactly at the artifact origin.",
      "expected": {
        "require_same_sized_source_object": false,
        "small_child_remains_candidate": true,
        "inspect_effective_runtime_geometry": true,
        "visual_resemblance_alone_identifies_owner": false
      }
    },
    {
      "id": "effective-runtime-geometry-traces-small-producer",
      "prompt": "A small declared UI child can be affected by minimum/content sizing, parent layout, overflow/clipping, transforms, or stretch/fit semantics. The visible defect is much larger than its declared size.",
      "expected": {
        "declared_size_is_final_geometry": false,
        "inspect_material_runtime_geometry_semantics": true,
        "provider_specific_checklist_required": false
      }
    },
    {
      "id": "post-compaction-discovers-existing-working-aid",
      "prompt": "Before context compaction the agent created a useful menu_surface_atlas.html. After continuation, memory no longer mentions it, but the file remains in the workspace and is relevant to the current UI task.",
      "expected": {
        "trust_memory_for_workspace_contents": false,
        "cheap_workspace_discovery_first": true,
        "discover_existing_working_aid": true,
        "recreate_without_checking": false
      }
    },
    {
      "id": "workspace-discovery-does-not-load-everything",
      "prompt": "After compaction a repository contains hundreds of files, several Skills, an index, a Working Atlas, and two sources relevant to the current task.",
      "expected": {
        "cheap_discovery_before_loading": true,
        "load_entire_workspace": false,
        "load_all_skills": false,
        "jit_consume_only_material_artifacts": true
      }
    },
    {
      "id": "existing-working-aid-reused-not-recreated",
      "prompt": "A current suitable Working Atlas already maps the relevant screen and links its canonical sources. The agent is about to create another atlas after continuation.",
      "expected": {
        "reuse_existing_suitable_aid": true,
        "create_duplicate_aid": false,
        "working_aid_becomes_authority": false
      }
    },
    {
      "id": "working-aid-cache-yields-to-current-authority",
      "prompt": "A pre-compaction Working View says the button is left-aligned, while the current canonical surface authority and runtime state now require right alignment.",
      "expected": {
        "working_view_wins": false,
        "current_authority_runtime_wins": true,
        "reconcile_or_invalidate_stale_aid": true
      }
    },
    {
      "id": "compaction-uses-existing-routing-not-broad-rediscovery",
      "prompt": "After a context reset, a valid project index/routing artifact still points to the current owner and relevant source files.",
      "expected": {
        "reuse_existing_route": true,
        "broad_repository_rediscovery_required": false,
        "validate_route_against_current_state": true
      }
    }
  ]
}
